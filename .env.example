# ==============================================================================
# Environment Configuration Template for AI Finance Tracker
# ==============================================================================

# Backend (FastAPI on Render)
PORT=5055
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://neondb_owner:your_password@ep-your-instance.ap-southeast-1.aws.neon.tech/neondb?ssl=require
JWT_SECRET=replace_with_a_secure_random_secret_key_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=https://your-frontend.vercel.app
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend (Vite + React on Vercel)
VITE_API_URL=https://your-backend.onrender.com/api
